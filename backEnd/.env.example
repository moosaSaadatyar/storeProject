# ===========================
# نمونه‌ی متغیرهای محیطی — این فایل را کپی کنید: cp .env.example .env
# ===========================

# پورت سرور API
PORT=3000

# آدرس MongoDB — اگر خالی بماند، در محیط توسعه از MongoDB درون‌حافظه‌ای استفاده می‌شود (داده‌ها با ری‌استارت پاک می‌شوند)
MONGO_URI=mongodb://localhost:27017/cabinet-store

# راز امضای JWT — حتماً در محیط تولید مقدار تصادفی طولانی بگذارید
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# مبدأ مجاز CORS (فرانت‌اند) — برای چند مبدأ از ویرگول استفاده کنید
CORS_ORIGIN=http://localhost:4200

# محدودیت‌های آپلود فایل
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_UPLOAD=8

# حساب مدیر اولیه (در اولین اجرای seed ایجاد می‌شود)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# درج داده‌های نمونه (true/false) — فقط وقتی پروژه‌ها خالی باشند
SEED_SAMPLE_DATA=true
